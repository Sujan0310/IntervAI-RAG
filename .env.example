# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/interview_rag

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Configuration - LM Studio (OpenAI-compatible)
LLM_TYPE=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=your-model-name-here
LMSTUDIO_API_KEY=your-api-key-if-required

# Embedding Configuration
# Local embeddings (recommended)
EMBEDDING_TYPE=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: OpenAI embeddings
# EMBEDDING_TYPE=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, chroma
VECTOR_STORE_PATH=./data/vector_stores

# Retrieval Configuration
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.7
USE_HYBRID_RETRIEVAL=true
HYBRID_ALPHA=0.5  # Weight for dense vs sparse (0=sparse only, 1=dense only)

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=semantic  # Options: fixed, semantic, recursive

# RAG Configuration
STRICT_RAG_MODE=true
REQUIRE_SOURCE_ATTRIBUTION=true
MIN_CONFIDENCE_THRESHOLD=0.6
MAX_CONTEXT_LENGTH=2048

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Interview RAG System
